# Copy to backend/.env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://incident_platform:incident_platform@localhost:5432/incident_platform

REDIS_URL=redis://localhost:6379

# Set a hard spend limit on this key in the OpenAI dashboard before using it.
OPENAI_API_KEY=sk-replace-me

# Optional: raises GitHub REST API rate limits from 60/hr to 5000/hr.
GITHUB_TOKEN=

FRONTEND_URL=http://localhost:5173
