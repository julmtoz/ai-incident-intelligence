# Copy to backend/.env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://incident_platform:incident_platform@localhost:5433/incident_platform

REDIS_URL=redis://localhost:6379

# Set a hard spend limit on this key in the OpenAI dashboard before using it.
OPENAI_API_KEY=sk-replace-me

# Optional server-side token. Public issue search falls back to unauthenticated requests.
GITHUB_TOKEN=

FRONTEND_URL=http://localhost:5173

# Production hardening defaults. FRONTEND_URL is optional for same-origin deployments.
BODY_LIMIT=16kb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
SUBMISSION_RATE_LIMIT_MAX=10
STATIC_DIR=../frontend/dist
TRUST_PROXY=false
